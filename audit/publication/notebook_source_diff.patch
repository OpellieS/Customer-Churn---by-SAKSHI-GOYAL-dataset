 source_sha256 = hashlib.sha256(input_file.read_bytes()).hexdigest()
 print("Source SHA-256:", source_sha256)
 raw = pd.read_csv(input_file)
+
+REQUIRED_NUMERIC_FIELDS = ['Customer_Age', 'Dependent_count', 'Months_on_book', 'Total_Relationship_Count', 'Months_Inactive_12_mon', 'Contacts_Count_12_mon', 'Credit_Limit', 'Total_Revolving_Bal', 'Avg_Open_To_Buy', 'Total_Amt_Chng_Q4_Q1', 'Total_Trans_Amt', 'Total_Trans_Ct', 'Total_Ct_Chng_Q4_Q1', 'Avg_Utilization_Ratio']
+REQUIRED_CATEGORICAL_FIELDS = ['Gender', 'Education_Level', 'Marital_Status', 'Income_Category', 'Card_Category']
+
+def validate_source_schema(frame):
+    required = {"CLIENTNUM", "Attrition_Flag", *REQUIRED_NUMERIC_FIELDS, *REQUIRED_CATEGORICAL_FIELDS}
+    missing = sorted(required - set(frame.columns))
+    if missing:
+        raise ValueError(f"Missing required source columns before EDA: {missing}")
+    wrong_types = [field for field in REQUIRED_NUMERIC_FIELDS if not pd.api.types.is_numeric_dtype(frame[field])]
+    if wrong_types:
+        raise TypeError(f"Expected numeric source fields before EDA: {wrong_types}")
+    numeric_categories = [field for field in REQUIRED_CATEGORICAL_FIELDS if pd.api.types.is_numeric_dtype(frame[field])]
+    if numeric_categories:
+        raise TypeError(f"Expected categorical source fields before EDA: {numeric_categories}")
+
+validate_source_schema(raw)
+print("Required source columns and types verified before EDA.")
+
 assert raw.columns.is_unique, "Duplicate column names require source correction."
